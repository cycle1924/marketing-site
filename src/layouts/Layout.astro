---
// Shared layout for every page. Defines the header (logo, nav, book a
// demo button) and footer exactly once. Pages pass a title, description,
// and which nav item is active.
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { forms } from '../config/forms';

interface Props {
  title: string;
  description: string;
  active?: 'pricing' | 'whitepaper' | 'faq' | 'demo';
  /** Keep this page out of search results, for short-lived event pages like /ilc. */
  noindex?: boolean;
}
const { title, description, active, noindex = false }: Props = Astro.props;

// Self-referencing canonical derived from the page's own path against the
// site URL in astro.config.mjs, so new pages inherit it with no per-page
// wiring. og:url mirrors it below.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

const ogImage = 'https://www.peelforward.com/og-image.png';

// Organization and WebSite structured data, one block on every page. The
// WebSite publisher references the Organization node by id.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.peelforward.com/#organization',
      name: 'PeelForward',
      url: 'https://www.peelforward.com',
      logo: 'https://www.peelforward.com/icon-512.png',
      parentOrganization: { '@type': 'Organization', name: 'Peel Business Design' },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.peelforward.com/#website',
      name: 'PeelForward',
      url: 'https://www.peelforward.com',
      publisher: { '@id': 'https://www.peelforward.com/#organization' },
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <!-- Icon order matters: browsers pick the last supported link, so the SVG
       must follow the ICO. icon-16 and icon-32 are manifest fallbacks and
       are deliberately not linked here. -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="PeelForward" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <!-- Alt text describes what og-image.png actually says, so the two change
       together. The card reads "Continuous improvement you can prove" over
       "Your data, your decisions." -->
  <meta property="og:image:alt" content="PeelForward. Continuous improvement you can prove. Your data, your decisions." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <!-- The font is served from this site, so there is no third-party
       stylesheet and no preconnect to Google. See src/styles/fonts.css.
       These two weights carry almost all visible text above the fold, so
       they are fetched alongside the CSS rather than after it. -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/hanken-grotesk-latin-400-normal.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/hanken-grotesk-latin-800-normal.woff2" crossorigin />
  <!-- The HubSpot tracking loader is deliberately NOT here. It used to run
       on every page load, setting its cookies before a visitor had any say.
       src/scripts/consent.ts injects it, and only after someone accepts in
       the banner at the end of the body. -->
</head>
<body>

<!-- ============ HEADER ============ -->
<header class="site-header">
  <div class="container">
    <nav class="nav">
      <Logo variant="header" />
      <div class="nav-links" id="navLinks">
        <a href="/pricing" class={active === 'pricing' ? 'active' : undefined}>Pricing</a>
        <a href="/whitepaper" class={active === 'whitepaper' ? 'active' : undefined}>White paper</a>
        <a href="/faq" class={active === 'faq' ? 'active' : undefined}>FAQ</a>
        <a href="/demo" class={active === 'demo' ? 'active' : undefined}>Demo</a>
        <!-- Sits inside nav-links so it inherits the plain nav link styling. Book
             a demo stays the only loud action, so this must not be a button. -->
        <a href="https://app.peelforward.com">Log in</a>
      </div>
      <div class="nav-spacer"></div>
      <div class="nav-cta">
        <a href="/demo" class="btn btn-primary">Book a demo</a>
        <button class="nav-toggle" id="navToggle" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<slot />

<!-- ============ FOOTER ============ -->
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo variant="footer" />
        <p class="footer-blurb">Built on Peel Signal Theory.</p>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/whitepaper">White paper</a></li>
        </ul>
      </div>
      <div class="footer-signup">
        <label for="footerEmail">Stay in the loop</label>
        <p>We’ll notify you when exciting things happen. No spam.</p>
        <form class="signup-row" id="signupForm" novalidate>
          <input id="footerEmail" type="email" placeholder="you@company.com" required />
          <button class="btn btn-primary" type="submit">Subscribe</button>
        </form>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 PeelForward. All rights reserved.</span>
      <span class="footer-bottom-links">
        <a href="/cookies">Cookies</a>
        <!-- Reopens the consent banner. A button, not a link, because it does
             something rather than going somewhere; consent.ts binds every
             element carrying data-cookie-settings. -->
        <button class="footer-settings" type="button" data-cookie-settings>Cookie settings</button>
      </span>
      <span>Continuous improvement, operationalized.</span>
    </div>
  </div>
</footer>

<CookieBanner />

<script>
  // Mobile nav toggle
  const tgl = document.getElementById('navToggle');
  const lnk = document.getElementById('navLinks');
  if (tgl && lnk) tgl.addEventListener('click', () => lnk.classList.toggle('open'));

  // Newsletter signup. Phase 2 will wire this to a real list; for now we
  // intercept the submit and confirm inline so the site demos cleanly.
  const signup = document.getElementById('signupForm') as HTMLFormElement | null;
  if (signup) {
    signup.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!signup.checkValidity()) { signup.reportValidity(); return; }
      signup.innerHTML = '<p class="signup-success">Thanks. You are on the list.</p>';
    });
  }
</script>
</body>
</html>
