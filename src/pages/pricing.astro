---
import Layout from '../layouts/Layout.astro';

// Comparison grid is data driven. To update tiers or rows later, edit these
// two arrays only. The order of cells in each row matches the order of tiers.
type Cell =
  | { kind: 'price'; amount: string; per: string }
  | { kind: 'priceText'; text: string }
  | { kind: 'text'; text: string }
  | { kind: 'included' }
  | { kind: 'absent' };

interface Tier {
  name: string;
  highlight: boolean;
  badge?: string;
  cta: { label: string; variant: 'btn-primary' | 'btn-secondary' };
}

interface Row {
  label: string;
  isPrice?: boolean;
  cells: Cell[];
}

const tiers: Tier[] = [
  { name: 'Foundation', highlight: false, cta: { label: 'Book a demo', variant: 'btn-secondary' } },
  { name: 'Standard', highlight: true, badge: 'Most popular', cta: { label: 'Book a demo', variant: 'btn-primary' } },
  { name: 'Enterprise', highlight: false, cta: { label: 'Contact sales', variant: 'btn-secondary' } },
];

const rows: Row[] = [
  { label: 'Price', isPrice: true, cells: [
    { kind: 'price', amount: '$30K', per: '/yr' },
    { kind: 'price', amount: '$72K', per: '/yr' },
    { kind: 'priceText', text: 'Contact sales' },
  ] },
  { label: 'Lifecycles included', cells: [{ kind: 'text', text: '1' }, { kind: 'text', text: 'Up to 3' }, { kind: 'text', text: 'Custom' }] },
  { label: 'Users', cells: [{ kind: 'text', text: '3' }, { kind: 'text', text: '8' }, { kind: 'text', text: 'Unlimited' }] },
  { label: 'AI-guided root cause analysis', cells: [{ kind: 'text', text: 'You ask, AI investigates' }, { kind: 'text', text: 'AI investigates automatically' }, { kind: 'text', text: 'AI investigates automatically' }] },
  { label: 'Data source connections', cells: [{ kind: 'text', text: '3' }, { kind: 'text', text: '9' }, { kind: 'text', text: 'Unlimited' }] },
  { label: 'Support level', cells: [{ kind: 'text', text: 'Email support' }, { kind: 'text', text: 'Priority support' }, { kind: 'text', text: 'Dedicated contact' }] },
  { label: 'All your lifecycles in one view', cells: [{ kind: 'absent' }, { kind: 'included' }, { kind: 'included' }] },
  { label: 'Complete history of every change', cells: [{ kind: 'absent' }, { kind: 'included' }, { kind: 'included' }] },
  { label: 'Export all your data anytime', cells: [{ kind: 'absent' }, { kind: 'absent' }, { kind: 'included' }] },
  { label: 'Sign in with your company login (SSO)', cells: [{ kind: 'absent' }, { kind: 'absent' }, { kind: 'included' }] },
];

// One definition, used both as the note under the grid and as the lifecycle
// FAQ answer, so the two can never drift apart.
const lifecycleDefinition = 'A lifecycle is a part of your operation whose signals PeelForward monitors.';

// Capabilities every tier carries, so they are stated once here rather than
// repeated as an all-Included row in the comparison grid above.
const includedInEveryTier = [
  'Monitoring across all seven signal types: Drift, Leading, Constraint, Outcome, Gap, Readiness, and Damping',
  'Reporting and dashboards',
  'Human-centered by design: AI proposes, humans accept',
  'Your data isolated in a dedicated tenant schema',
  'AI features run on your own Anthropic API key, with a rules engine that converts proven AI patterns into deterministic checks to control AI cost',
];

const faqs = [
  { q: 'What is a lifecycle?', a: lifecycleDefinition, open: true },
  { q: 'Do we need continuous improvement experience?', a: 'No. PeelForward is built for teams without CI training. The method is in the platform.', open: false },
  { q: 'What systems does it connect to?', a: 'PeelForward connects to the common systems mid-market operations already run on: ERP, MES, spreadsheets, and BI tools among them.', open: false },
  { q: 'How long does implementation take?', a: 'Implementation is scoped to your operation by a certified consultant. Typical timelines will be confirmed during your demo.', open: false },
];
---
<Layout
  title="PeelForward: Pricing"
  description="Tiers are based on the number of lifecycles you manage in PeelForward. Every tier includes all seven signal types. Implementation services are scoped and quoted separately."
  active="pricing"
>

<section class="pricing-hero">
  <div class="container">
    <div class="inner">
      <span class="eyebrow">Pricing</span>
      <h1>Pricing built for growth.</h1>
      <p class="lead maxw-prose mx-auto">Tiers are based on the number of lifecycles you manage in PeelForward. Every tier includes all seven signal types. Implementation services are scoped and quoted separately.</p>
      <p class="positioning maxw-prose mx-auto">GPS for your business: continuous monitoring of operational health, with verifiable proof when an improvement is real and holds.</p>
    </div>
  </div>
</section>

<section class="section container">
  <div class="compare-wrap">
    <table class="compare">
      <thead>
        <tr>
          <th class="rowlabel"></th>
          {tiers.map((tier) => (
            <th class={tier.highlight ? 'col-std' : undefined}>
              {tier.badge && <span class="badge-sm">{tier.badge}</span>}
              <div class="tier-name">{tier.name}</div>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class={row.isPrice ? 'row-price' : undefined}>
            <th class="rowlabel">{row.label}</th>
            {row.cells.map((cell, i) => (
              <td class={tiers[i].highlight ? 'col-std' : undefined}>
                {cell.kind === 'price' && <span class="cell-price">{cell.amount}<span class="per">{cell.per}</span></span>}
                {cell.kind === 'priceText' && <span class="cell-price">{cell.text}</span>}
                {cell.kind === 'text' && <span class="cell-text">{cell.text}</span>}
                {cell.kind === 'absent' && (
                  <span class="cell-absent"><span aria-hidden="true">&ndash;</span><span class="visually-hidden">Not included</span></span>
                )}
                {cell.kind === 'included' && (
                  <span class="cell-inc"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Included</span>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr>
          <td class="rowlabel"></td>
          {tiers.map((tier) => (
            <td class={tier.highlight ? 'col-std' : undefined}>
              <a class={`btn ${tier.cta.variant}`} href="/demo">{tier.cta.label}</a>
            </td>
          ))}
        </tr>
      </tfoot>
    </table>
  </div>

  <p class="lifecycle-note">{lifecycleDefinition}</p>

  <div class="every-tier">
    <h3>Included in every tier</h3>
    <ul>
      {includedInEveryTier.map((item) => (
        <li>
          <span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="impl-note">
    <span class="ico">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
    </span>
    <div>
      <p><strong class="lead-in">Implementation: included in every deployment.</strong> Every PeelForward deployment includes hands-on implementation by a certified consultant, scoped to your operation and quoted separately from your subscription. Delivered remotely, on-site travel billed at cost.</p>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section-tight container">
  <div class="faq">
    <h2>Questions, answered.</h2>
    {faqs.map((item) => (
      <details class="faq-item" open={item.open}>
        <summary class="faq-q">{item.q}
          <span class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span>
        </summary>
        <div class="faq-a">{item.a}</div>
      </details>
    ))}
  </div>
</section>

<!-- Bottom CTA -->
<section class="section-tight container">
  <div class="cta-band">
    <h2>See it on your own data. Book a demo.</h2>
    <a href="/demo" class="btn btn-primary btn-lg">Book a demo <span class="arrow">→</span></a>
  </div>
</section>

</Layout>

<style>
  .pricing-hero { background: linear-gradient(180deg, var(--color-white) 0%, var(--color-bg-neutral) 100%); border-bottom: 1px solid var(--color-border); }
  .pricing-hero .inner { text-align: center; max-width: 60ch; margin-inline: auto; padding-block: var(--pad-pricing-hero); }
  .pricing-hero h1 { margin: var(--space-16) 0 var(--space-18); }
  .pricing-hero .lead { margin-inline: auto; }
  .positioning {
    margin-top: var(--space-18); margin-inline: auto;
    color: var(--color-text-muted); font-size: var(--fs-105); line-height: var(--lh-copy);
  }

  /* Comparison table */
  .compare-wrap {
    /* Containing block for the absolutely positioned .visually-hidden labels
       in the dash cells. Without this the wrapper is static, so those spans
       resolve against the initial containing block, escape this scroll
       container unclipped, and drag the whole page sideways on a phone. */
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    -webkit-overflow-scrolling: touch;
  }
  .compare { width: 100%; border-collapse: collapse; min-width: 800px; background: var(--color-white); }
  .compare th, .compare td {
    padding: var(--space-15) var(--space-22);
    border-bottom: 1px solid var(--color-border);
    text-align: center;
    font-size: var(--fs-096);
  }
  .compare tfoot td, .compare tfoot th { border-bottom: none; }
  .compare .rowlabel { text-align: left; font-weight: var(--fw-semibold); color: var(--color-text); width: 30%; }
  .compare tbody .rowlabel { font-weight: var(--fw-medium); color: var(--color-text-muted); }
  .compare thead th { background: var(--color-bg-neutral); vertical-align: bottom; padding-top: var(--space-26); padding-bottom: var(--space-22); }
  .compare thead .rowlabel { background: var(--color-bg-neutral); }
  .compare .tier-name { font-size: var(--fs-118); font-weight: var(--fw-extrabold); letter-spacing: var(--ls-tight-3); }
  .compare .col-std { background: var(--color-accent-soft); }
  .compare thead .col-std { box-shadow: inset 0 3px 0 var(--color-accent); }
  .badge-sm {
    display: inline-block; margin-bottom: var(--space-9);
    background: var(--color-accent); color: var(--color-white);
    font-size: var(--fs-068); font-weight: var(--fw-bold); letter-spacing: var(--ls-wide-3); text-transform: uppercase;
    padding: var(--space-4) var(--space-11); border-radius: var(--r-pill);
  }
  .row-price td, .row-price th { padding-top: var(--space-18); padding-bottom: var(--space-18); }
  .cell-price { font-size: var(--fs-118); font-weight: var(--fw-extrabold); letter-spacing: var(--ls-tight-2); color: var(--color-text); }
  .cell-price .per { font-size: var(--fs-084); font-weight: var(--fw-semibold); color: var(--color-text-muted); }
  .cell-inc { color: var(--color-accent); font-weight: var(--fw-bold); display: inline-flex; align-items: center; gap: var(--space-7); }
  .cell-text { color: var(--color-text); }
  .cell-absent { color: var(--color-slate-400); font-weight: var(--fw-semibold); }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .compare tfoot td { padding-top: var(--space-22); padding-bottom: var(--space-24); }
  .compare tfoot .btn { min-width: 150px; }

  /* FAQ */
  .faq { max-width: 760px; margin-inline: auto; }
  .faq h2 { text-align: center; margin-bottom: var(--space-40); }
  .faq-item { border-bottom: 1px solid var(--color-border); }
  .faq-q {
    width: 100%; text-align: left; background: none; border: none;
    padding: var(--space-24) 0; display: flex; align-items: center; gap: var(--space-16);
    font-family: inherit; font-size: var(--fs-112); font-weight: var(--fw-bold); color: var(--color-text);
    letter-spacing: var(--ls-tight-3);
  }
  .faq-q .ico { margin-left: auto; flex: none; color: var(--color-accent); transition: transform .25s ease; }
  .faq-item[open] .faq-q .ico { transform: rotate(45deg); }
  .faq-a { padding: 0 0 var(--space-24); color: var(--color-text-muted); max-width: 64ch; line-height: var(--lh-copy); }
  details > summary { list-style: none; cursor: pointer; }
  details > summary::-webkit-details-marker { display: none; }

  /* Lifecycle definition, accent note directly under the grid */
  .lifecycle-note {
    margin-top: var(--space-18);
    color: var(--color-accent); font-weight: var(--fw-semibold);
    font-size: var(--fs-100); line-height: var(--lh-copy);
  }

  /* Included in every tier */
  .every-tier {
    background: var(--color-bg-neutral); border: 1px solid var(--color-border);
    border-radius: var(--r-lg); padding: var(--space-26) var(--space-28);
    margin-top: var(--space-28);
  }
  .every-tier h3 { font-size: var(--fs-108); margin-bottom: var(--space-16); }
  .every-tier ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-12); }
  .every-tier li {
    display: flex; gap: var(--space-11); align-items: flex-start;
    color: var(--color-text-muted); line-height: var(--lh-copy); max-width: 74ch;
  }
  .every-tier .ico { flex: none; color: var(--color-accent); margin-top: 4px; }

  /* Implementation note */
  .impl-note {
    display: flex; gap: var(--space-18); align-items: flex-start;
    background: var(--color-bg-neutral); border: 1px solid var(--color-border);
    border-radius: var(--r-lg); padding: var(--space-26) var(--space-28);
    margin-top: var(--space-28);
  }
  .impl-note .ico {
    width: 44px; height: 44px; flex: none; border-radius: var(--r-md);
    background: var(--color-accent-soft); color: var(--color-accent);
    display: grid; place-items: center;
  }
  /* Bold inline lead-in opening the single implementation paragraph. */
  .impl-note .lead-in { color: var(--color-text); font-weight: var(--fw-bold); }
  .impl-note p { color: var(--color-text-muted); max-width: 74ch; }
  @media (max-width: 560px) { .impl-note { flex-direction: column; gap: var(--space-14); } }

  /* bottom CTA */
  .cta-band { text-align: center; }
  .cta-band h2 { margin-bottom: var(--space-24); }
</style>
